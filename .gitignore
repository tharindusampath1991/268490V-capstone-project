# Secrets. The ENTSO-E token lives in .env and is never committed.
.env
.env.*
!.env.example

# Data. Raw downloads and processed tables are rebuilt by scripts.
# Anchored to the repo root so src/epf/data/ stays tracked.
/data/

# Virtual environment
.venv/

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
*.egg-info/

# Model weights and checkpoints. Anchored to the repo root so src/epf/models/ stays tracked.
/models/
*.safetensors
*.pt
*.pth
*.ckpt
*.bin

# Notebook checkpoints
.ipynb_checkpoints/
